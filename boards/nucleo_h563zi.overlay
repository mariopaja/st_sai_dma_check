/ {
	aliases {
		i2s-tx = &sai1_a;
		i2s-rx = &sai1_b;
	};

	/* Pins sampled through GPIO IDR; they stay in SAI alternate function */
	zephyr,user {
		sai-fs-gpios = <&gpioe 4 0>;
		sai-mclk-gpios = <&gpioe 2 0>;
	};
};

&pll3 {
	/* 44.1KHz (0.0% Error) */
	div-m = <1>;
	mul-n = <35>;
	div-q = <2>;
	div-r = <2>;
	div-p = <25>;
	clocks = <&clk_hse>;
	status = "okay";
};

&sai1 {
	clocks = <&rcc STM32_CLOCK(APB2, 21)>,
		 <&rcc STM32_SRC_PLL3_P SAI1_SEL(2)>;
	status = "okay";
};

&sai1_a {
	pinctrl-0 = <&sai1_mclk_a_pe2 &sai1_sd_a_pe6 &sai1_fs_a_pe4 &sai1_sck_a_pe5>;
	pinctrl-names = "default";
	status = "okay";
	mclk-enable;
	mclk-divider = "div-256";
	dma-names = "tx";
};

&sai1_b {
	pinctrl-0 = <&sai1_sd_b_pe3 &sai1_fs_b_pf9 &sai1_sck_b_pf8>;
	pinctrl-names = "default";
	status = "okay";
	mclk-divider = "div-256";
	dma-names = "rx";
};
