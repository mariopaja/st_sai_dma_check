/ {
	aliases {
		i2s-tx = &sai1_a;
		i2s-rx = &sai1_b;
	};

	/* Pins sampled through GPIO IDR; they stay in SAI alternate function */
	zephyr,user {
		sai-fs-gpios = <&gpioe 4 0>;
		sai-mclk-gpios = <&gpioe 2 0>;
	};
};

&pll2 {
	/* 44.1KHz (0.03% Error) */
	div-m = <8>;
	mul-n = <192>;
	div-q = <2>;
	div-r = <2>;
	div-p = <17>;
	clocks = <&clk_hse>;
	status = "okay";
};

&sai1 {
	status = "okay";
	clocks = <&rcc STM32_CLOCK(APB2, 22)>,
		 <&rcc STM32_SRC_PLL2_P SAI1_SEL(1)>;
};

&sai1_a {
	pinctrl-0 = <&sai1_mclk_a_pe2 &sai1_sd_a_pe6 &sai1_fs_a_pe4 &sai1_sck_a_pe5>;
	pinctrl-names = "default";
	status = "okay";
	mclk-enable;
	mclk-divider = "div-256";
	dma-names = "tx";
};

&sai1_b {
	pinctrl-0 = <&sai1_sd_b_pe3 &sai1_fs_b_pf9 &sai1_sck_b_pf8>;
	pinctrl-names = "default";
	status = "okay";
	mclk-divider = "div-256";
	dma-names = "rx";
};

&dmamux1 {
	status = "okay";
};

&dma1 {
	status = "okay";
};
