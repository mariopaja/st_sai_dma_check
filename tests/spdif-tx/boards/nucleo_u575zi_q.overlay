/*
 * SAI1_A: S/PDIF TX controller, SD PE6
 * SAI1_B: RX controller sampling the S/PDIF line, SD PE3
 * Wiring: PE6-PE3 only. SCK/FS pins are not used, so the PE5-PF8 and
 * PE4-PF9 jumpers may stay fitted or not.
 */

&pll2 {
	/* 4 MHz MSIS * 79 / 7 = 45.14 MHz */
	div-m = <1>;
	mul-n = <79>;
	div-q = <2>;
	div-r = <2>;
	div-p = <7>;
	clocks = <&clk_msis>;
	status = "okay";
};

&sai1 {
	status = "okay";
};

&sai1_a {
	pinctrl-0 = <&sai1_sd_a_pe6>;
	pinctrl-names = "default";
	dma-names = "tx";
	st,sai-spdif;
	status = "okay";
};

&sai1_b {
	pinctrl-0 = <&sai1_sd_b_pe3>;
	pinctrl-names = "default";
	dma-names = "rx";
	status = "okay";
};
